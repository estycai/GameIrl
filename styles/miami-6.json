{
  "version": 8,
  "name": "miami-6",
  "metadata": {
    "template": "miami-6",
    "visual_intent": "Neon and pastel over a dark base. Deep navy water, near-black land, teal and magenta road hierarchy, warm sand landuse, glowing label halos.",
    "TODO": "Replace Noto Sans font stacks with custom retro/synthwave SDF glyphs and add custom sprite sheets for POI icons and highway shields. Replace POI circle markers with custom neon sprite icons."
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
